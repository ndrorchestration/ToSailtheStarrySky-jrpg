{
  "name": "Aetherwake",
  "version": "0.2.0",
  "description": "Aetherwake pre-alpha — a solarpunk turn-based JRPG built with p5.js",
  "main": "index-embedded.html",
  "window": {
    "title": "AETHERWAKE — THE LAST SOLARPUNK AIRSHIP",
    "width": 1440,
    "height": 960,
    "min_width": 960,
    "min_height": 640,
    "toolbar": false,
    "resizable": true,
    "icon": "icon.svg",
    "position": "center",
    "show": true,
    "frame": true,
    "fullscreen": false,
    "kiosk": false,
    "focus": true
  },
  "webkit": {
    "plugin": false,
    "page-cache": true
  },
  "js-flags": "--expose-gc",
  "chromium-args": "--disable-gpu-compositing --disable-gpu-rasterization",
  "devDependencies": {
    "nw": "^0.116.0",
    "nwjs": "^1.4.4",
    "playwright": "^1.63.0",
    "nw-builder": "^4.5.0"
  },
  "private": true,
  "scripts": {
    "test:smoke": "node tests/smoke-playwright.js",
    "playwright:install": "playwright install chromium",
    "test:effects": "node tests/effect-vocabulary.test.js",
    "test:registries": "node tests/registry-contract.test.js",
    "test:resolver": "node tests/effect-resolver.test.js",
    "test:resolver-integration": "node tests/resolver-integration.test.js",
    "test:enemy-metadata": "node tests/enemy-metadata-contract.test.js",
    "test:combat-input": "node tests/combat-input-contract.test.js",
    "test:resource-eligibility": "node tests/resource-eligibility.test.js",
    "test:progression-reachability": "node tests/progression-reachability.test.js",
    "test:secondary-action": "node tests/secondary-action-contract.test.js",
    "test:magic-defs": "node tests/magic-defs-contract.test.js",
    "package:windows": "npm run stage:desktop && nwbuild --mode=build --glob=false --platform=win --arch=x64 --version=0.116.0 --outDir=../aetherwake-dist --app.icon=.desktop-runtime/www/icon.ico .desktop-runtime",
    "package:windows:clean": "npm run package:windows",
    "test:desktop-package": "node tests/desktop-package-contract.test.js",
    "test:magic-mastery": "node tests/magic-mastery-contract.test.js",
    "test:character-magic-profile": "node tests/character-magic-profile-contract.test.js",
    "test:party-magic-profile": "node tests/party-magic-profile-contract.test.js",
    "test:magic-field-reactions": "node tests/magic-field-reactions-contract.test.js",
    "test:elemental-spell-trees": "node tests/elemental-spell-trees-contract.test.js",
    "test:non-elemental-spell-trees": "node tests/non-elemental-spell-trees-contract.test.js",
    "test:magic-spell-access": "node tests/magic-spell-access-contract.test.js",
    "test:magic-study": "node tests/magic-study-contract.test.js",
    "test:longform-progression": "node tests/longform-progression.test.js",
    "test:encounter-scaling": "node tests/encounter-scaling.test.js",
    "test:party-capacity": "node tests/party-capacity.test.js",
    "test:character-profiles": "node tests/character-stat-profiles.test.js",
    "test:jrpg-stat-model": "node tests/jrpg-stat-model.test.js",
    "test:jrpg-formula-engine": "node tests/jrpg-formula-engine.test.js",
    "test:commons-ledger": "node tests/commons-ledger.test.js",
    "test:aether-seal-contract": "node tests/aether-seal-contract.test.js",
    "test:character-canon": "node tests/character-canon-alignment.test.js",
    "test:runtime-ssot": "node tests/runtime-ssot-contract.test.js",
    "test:air-navigation": "node tests/air-navigation.test.js",
    "test:open-sky-runtime": "node tests/open-sky-runtime-contract.test.js",
    "test:first-wake-opening": "node tests/first-wake-opening.test.js",
    "test:overlay-contract": "node tests/runtime-overlay-contract.test.js",
    "test:input-runtime": "node tests/input-runtime-contract.test.js",
    "test:combat-runtime": "node tests/combat-runtime-contract.test.js",
    "stage:desktop": "node scripts/stage-memories-desktop.js",
    "test:cinematics": "node tests/cinematic-manifest-contract.test.js",
    "capture:player-evidence": "node scripts/capture-player-evidence.js",
    "test:player-evidence-capture": "node tests/player-evidence-capture-contract.test.js",
    "test:player-evidence-workflow": "node tests/player-evidence-workflow-contract.test.js",
    "test:quest-state": "node tests/quest-state-contract.test.js"
  }
}

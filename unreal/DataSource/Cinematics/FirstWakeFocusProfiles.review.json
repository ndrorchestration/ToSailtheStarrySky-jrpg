{
  "schema": "tstss.firstwake.dynamic_focus.review.v1",
  "project": "To Sail the Starry Sky",
  "engine": "Unreal Engine 5.8.4",
  "scope": "First Wake vertical-slice review only",
  "baseline_branch": "review/ue58-p0-playable-convergence-20261111",
  "baseline_sha": "76268b8975ec3ce7b7644b6223c09d4889b658a2",
  "implementation_status": "DATA_ONLY_NOT_CONNECTED_TO_RUNTIME",
  "use_for_gameplay": false,
  "outputs": {
    "review_root": "/Game/TSTSS/Review/DynamicFocus_V1",
    "must_duplicate_existing_level": true,
    "allow_source_map_overwrite": false,
    "allow_save_game_mutation": false,
    "allow_story_progress_mutation": false
  },
  "lens": {
    "filmback_width_mm": 36,
    "filmback_height_mm": 24,
    "diaphragm_blades": 9,
    "focus_smoothing_seconds": 0.6,
    "focus_hysteresis_cm": 40,
    "hold_focus_after_target_loss_seconds": 0.5
  },
  "guardrails": {
    "max_gameplay_blur_radius_viewport_percent": 0.65,
    "max_cinematic_blur_radius_viewport_percent": 2,
    "allow_motion_blur_in_navigation": false,
    "allow_rapid_autofocus_in_combat": false,
    "reduced_motion_disables_rack_focus": true,
    "protect_hud_and_interaction_prompts": true,
    "protect_traversal_ledge_visibility": true,
    "protect_enemy_targeting": true,
    "never_artificially_unlock_story_states": true,
    "excluded_party_members": [
      "Reson",
      "Aepex"
    ],
    "forbidden_ship_mode": "Starbourne"
  },
  "visual_effect_domains": {
    "bokeh": "optical defocus from scene depth, aperture and focus plane",
    "bloom": "highlight scattering; tune separately",
    "atmospheric_perspective": "haze/scattering from world atmosphere; not bokeh",
    "diffraction": "bright-light glints; not bokeh",
    "parallax": "camera motion against layered geometry; not bokeh"
  },
  "weather_policy": {
    "Clear": "no additional haze or lens wetness",
    "CoastalMist": "atmospheric scattering and horizon desaturation; keep interaction focus readable",
    "Rain": "real rainfall + wet reflections; optional *localized* lens-droplet look only in scripted shot",
    "Storm": "lightning exposure recovery and restrained bloom; prohibit focus pumping during gameplay",
    "Snow": "snow particle depth and atmospheric extinction; protect traversal",
    "Blizzard": "maximize clarity and avoid bokeh on navigation camera",
    "AuroralVeil": "retain crisp celestial anchors; aurora glow is not defocus"
  },
  "shots": [
    {
      "id": "FW01_Dock_Establish",
      "narrative": "Ender and Aureate Wake within immense coastal dock",
      "camera_state": "EXPLORATION",
      "lens_mm": 28,
      "f_stop": 5.6,
      "focus_mode": "manual",
      "focus_cm": 2500,
      "rack_focus_seconds": 0,
      "max_blur_percent": 0.65,
      "world_drivers": [
        "timeofday",
        "haze",
        "dock_lantern_placement",
        "near_far_geometry"
      ],
      "notes": "Use layered parallax and aerial perspective before applying DOF; restore deep focus for ledges"
    },
    {
      "id": "FW02_Ionia_Conversation",
      "narrative": "First connection and hiring conversation",
      "camera_state": "DIALOGUE",
      "lens_mm": 50,
      "f_stop": 2.8,
      "focus_mode": "actor_eye_tracking",
      "focus_cm": 180,
      "rack_focus_seconds": 0.7,
      "max_blur_percent": 1.6,
      "world_drivers": [
        "actor_eye_position",
        "practical_lanterns",
        "scene_blocking"
      ],
      "notes": "Focus Ender/Ionia eyes; background point lights may form round defocus discs; never blur dialogue text"
    },
    {
      "id": "FW03_Engine_Inspection",
      "narrative": "Ender diagnoses the old harmonic levitation engine",
      "camera_state": "INSPECT",
      "lens_mm": 65,
      "f_stop": 2.8,
      "focus_mode": "manual",
      "focus_cm": 85,
      "rack_focus_seconds": 0.9,
      "max_blur_percent": 2,
      "world_drivers": [
        "engine_core_position",
        "interactive_gauge_position",
        "emissive_practicals"
      ],
      "notes": "Rack from foreground resonator gauge to engine component only in authored camera; do not move objective state"
    },
    {
      "id": "FW04_Engine_Awakening",
      "narrative": "Unusual engine behavior hints at ship's deeper nature",
      "camera_state": "REVEAL",
      "lens_mm": 50,
      "f_stop": 4,
      "focus_mode": "tracked_subject",
      "focus_cm": 450,
      "rack_focus_seconds": 1.3,
      "max_blur_percent": 1.5,
      "world_drivers": [
        "engine_light_pulse",
        "ship_mechanical_motion",
        "actor_reaction"
      ],
      "notes": "Reveal with light, motion and slow focus; keep ship awareness narratively ambiguous"
    },
    {
      "id": "FW05_FirstWake_Liftoff",
      "narrative": "Aureate Wake departs dock",
      "camera_state": "ESTABLISH",
      "lens_mm": 24,
      "f_stop": 5.6,
      "focus_mode": "manual",
      "focus_cm": 4000,
      "rack_focus_seconds": 0,
      "max_blur_percent": 0.65,
      "world_drivers": [
        "altitude",
        "cloud_layers",
        "wind",
        "geometry_parallax"
      ],
      "notes": "Prefer deep focus and massive scale; DOF cannot substitute for altitude cues"
    },
    {
      "id": "FW06_Emergency_Splashdown",
      "narrative": "Critical emergency and actual sea contact",
      "camera_state": "ACTION",
      "lens_mm": 35,
      "f_stop": 8,
      "focus_mode": "manual",
      "focus_cm": 3000,
      "rack_focus_seconds": 0,
      "max_blur_percent": 0.4,
      "world_drivers": [
        "sea_surface",
        "spray",
        "sun_angle",
        "ship_velocity"
      ],
      "notes": "Prioritize physics truth, horizon and waterline; do not mask contact or fake flotation with camera cuts"
    },
    {
      "id": "FW07_Shore_Exploration",
      "narrative": "After splashdown, return to player-controlled exploration",
      "camera_state": "EXPLORATION",
      "lens_mm": 28,
      "f_stop": 5.6,
      "focus_mode": "manual",
      "focus_cm": 2500,
      "rack_focus_seconds": 0,
      "max_blur_percent": 0.65,
      "world_drivers": [
        "coastal_mist",
        "rain",
        "distant_lights",
        "terrain_occlusion"
      ],
      "notes": "Use fog extinction/contrast for distance; legible walkable boundaries and collision"
    },
    {
      "id": "FW08_Lyra_Introduction",
      "narrative": "Lyra and Talen introduced only at authorized post-splashdown beat",
      "camera_state": "DIALOGUE",
      "lens_mm": 50,
      "f_stop": 3.5,
      "focus_mode": "actor_eye_tracking",
      "focus_cm": 170,
      "rack_focus_seconds": 0.8,
      "max_blur_percent": 1.5,
      "world_drivers": [
        "actor_eye_position",
        "ambient_color",
        "foreground_occlusion"
      ],
      "notes": "No Lyra party/recruitment before post-splashdown unlock; Talen narrative only"
    },
    {
      "id": "FW09_NightSky_Wonder",
      "narrative": "Quiet night-sky reveal above shore or ship",
      "camera_state": "AWE",
      "lens_mm": 24,
      "f_stop": 5.6,
      "focus_mode": "manual",
      "focus_cm": 1000000,
      "rack_focus_seconds": 1.4,
      "max_blur_percent": 0.5,
      "world_drivers": [
        "sky_visibility",
        "cloud_cover",
        "aurora",
        "camera_orientation"
      ],
      "notes": "Focus the stars at effectively infinity; preserve pointlike stars and separate atmospheric/bloom; not a Starbourne unlock"
    }
  ],
  "qa": {
    "source_validation": "python unreal/Tools/validate_first_wake_focus_profiles.py --self-test",
    "native_capture_required": true,
    "exact_commit_required": true,
    "compare_dof_on_off": true,
    "compare_weather_clear_rain_mist": true,
    "verify_reduced_motion": true,
    "verify_ledge_navigation": true,
    "verify_native_frame_time_memory": true,
    "creator_approval_required": true
  }
}
